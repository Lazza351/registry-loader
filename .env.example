# No real credentials. Copy to .env, chmod 600 .env, then fill locally.
# Optional CSV of container paths; overrides single /data/input (no recursion).
# Example: /data/input/docker,/data/input/pypi
INPUT_DIRS=
DOCKER_REGISTRY=nexus.example.org:5000
DOCKER_USERNAME=
DOCKER_PASSWORD=
PYPI_URL=https://nexus.example.org/repository/pypi-hosted/
PYPI_USERNAME=
PYPI_PASSWORD=
TLS_VERIFY=true
# Optional PyPI override; empty uses TLS_VERIFY in compose.
PYPI_TLS_VERIFY=
# For compose put PEM in ./certs and set /certs/company-ca.pem
CA_BUNDLE=
IMAGE_PREFIX_MODE=prepend
IMAGE_PREFIX=
IMAGE_SOURCE_PREFIX=
POLL_INTERVAL=2
STABLE_SECONDS=10
UPLOAD_TIMEOUT=300
UPLOAD_RETRIES=2
UPLOADER_UID=10001
UPLOADER_GID=10001
# Replace with the host's docker.sock group ID (stat -c '%g' /var/run/docker.sock).
DOCKER_SOCKET_GID=999
