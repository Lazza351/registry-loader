# No real credentials. Copy to .env, chmod 600 .env, then fill locally.
# Optional CSV of container paths; overrides single /data/input (no recursion).
# Example: /data/input/docker,/data/input/pypi
INPUT_DIRS=
DOCKER_REGISTRY=nexus.example.org:5000
DOCKER_USERNAME=
DOCKER_PASSWORD=
PYPI_URL=https://nexus.example.org/repository/pypi-hosted/
PYPI_USERNAME=
PYPI_PASSWORD=
# Default: reject existing artifacts and preserve failed payloads in error/.
# true allows Docker tag replacement and deletes existing PyPI Nexus components first.
# PyPI overwrite requires PYPI credentials with component delete rights.
ALLOW_OVERWRITE=false
# Optional Nexus API root, e.g. https://nexus.example.org (no trailing slash).
# Empty derives scheme/host from PYPI_URL=/repository/<name>/... when possible.
# Without API root/repository name, PyPI upload proceeds with one warning per process.
NEXUS_API_URL=
# Docker existence probe: true uses HTTPS/CA verification, false uses plain HTTP.
# Also the default for PyPI TLS; Docker push TLS is configured in the host Engine.
TLS_VERIFY=true
# Optional PyPI upload/Nexus API TLS override; empty uses TLS_VERIFY in compose.
PYPI_TLS_VERIFY=
# For compose put PEM in ./certs and set /certs/company-ca.pem
CA_BUNDLE=
IMAGE_PREFIX_MODE=prepend
IMAGE_PREFIX=
IMAGE_SOURCE_PREFIX=
POLL_INTERVAL=2
# Minimum quiet window, not the sole completion signal (close events/writer probes also apply).
STABLE_SECONDS=10
UPLOAD_TIMEOUT=300
UPLOAD_RETRIES=2
UPLOADER_UID=10001
UPLOADER_GID=10001
# Replace with the host's docker.sock group ID (stat -c '%g' /var/run/docker.sock).
DOCKER_SOCKET_GID=999
